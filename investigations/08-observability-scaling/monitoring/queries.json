{
  "cpu_cores": "sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"aegis-step08\",container=\"api\"}[2m]))",
  "cfs_period_fraction": "sum by(pod)(rate(container_cpu_cfs_throttled_periods_total{namespace=\"aegis-step08\",container=\"api\"}[2m])) / clamp_min(sum by(pod)(rate(container_cpu_cfs_periods_total{namespace=\"aegis-step08\",container=\"api\"}[2m])), 0.000001)",
  "cfs_seconds_rate": "sum by(pod)(rate(container_cpu_cfs_throttled_seconds_total{namespace=\"aegis-step08\",container=\"api\"}[2m]))",
  "memory_working_set": "container_memory_working_set_bytes{namespace=\"aegis-step08\",container!=\"\",container!=\"POD\"}",
  "hpa_current": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"aegis-step08\"}",
  "hpa_desired": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"aegis-step08\"}",
  "hpa_conditions": "kube_horizontalpodautoscaler_status_condition{namespace=\"aegis-step08\"}",
  "requests": "kube_pod_container_resource_requests{namespace=\"aegis-step08\"}",
  "limits": "kube_pod_container_resource_limits{namespace=\"aegis-step08\"}",
  "pending": "kube_pod_status_phase{namespace=\"aegis-step08\",phase=\"Pending\"}",
  "ready": "kube_pod_status_ready{namespace=\"aegis-step08\",condition=\"true\"}",
  "restarts": "kube_pod_container_status_restarts_total{namespace=\"aegis-step08\"}",
  "oom_reason": "kube_pod_container_status_last_terminated_reason{namespace=\"aegis-step08\",reason=\"OOMKilled\"}",
  "up": "up",
  "node_pressure": "kube_node_status_condition{condition=~\"MemoryPressure|DiskPressure|PIDPressure\",status=\"true\"}",
  "placement": "kube_pod_info{namespace=\"aegis-step08\"}",
  "oom_current_reason": "kube_pod_container_status_terminated_reason{namespace=\"aegis-step08\",reason=\"OOMKilled\"}",
  "k6_cpu_cores": "sum by(namespace,pod,container)(rate(container_cpu_usage_seconds_total{namespace=\"aegis-step08\",container=\"k6\"}[2m]))",
  "k6_cfs_seconds_rate": "sum by(namespace,pod,container)(rate(container_cpu_cfs_throttled_seconds_total{namespace=\"aegis-step08\",container=\"k6\"}[2m]))",
  "k6_cfs_period_fraction": "sum by(namespace,pod,container)(rate(container_cpu_cfs_throttled_periods_total{namespace=\"aegis-step08\",container=\"k6\"}[2m])) / clamp_min(sum by(namespace,pod,container)(rate(container_cpu_cfs_periods_total{namespace=\"aegis-step08\",container=\"k6\"}[2m])),0.000001)",
  "monitoring_cpu_cores": "sum by(namespace,pod,container)(rate(container_cpu_usage_seconds_total{namespace=~\"aegis-step08-monitoring|kube-system\",container=~\"prometheus|config-reloader|grafana|kube-state-metrics|kube-prometheus-stack|node-exporter|metrics-server\"}[2m]))",
  "monitoring_cfs_seconds_rate": "sum by(namespace,pod,container)(rate(container_cpu_cfs_throttled_seconds_total{namespace=~\"aegis-step08-monitoring|kube-system\",container=~\"prometheus|config-reloader|grafana|kube-state-metrics|kube-prometheus-stack|node-exporter|metrics-server\"}[2m]))",
  "monitoring_cfs_period_fraction": "sum by(namespace,pod,container)(rate(container_cpu_cfs_throttled_periods_total{namespace=~\"aegis-step08-monitoring|kube-system\",container=~\"prometheus|config-reloader|grafana|kube-state-metrics|kube-prometheus-stack|node-exporter|metrics-server\"}[2m])) / clamp_min(sum by(namespace,pod,container)(rate(container_cpu_cfs_periods_total{namespace=~\"aegis-step08-monitoring|kube-system\",container=~\"prometheus|config-reloader|grafana|kube-state-metrics|kube-prometheus-stack|node-exporter|metrics-server\"}[2m])),0.000001)",
  "node_memory_available": "node_memory_MemAvailable_bytes",
  "node_memory_total": "node_memory_MemTotal_bytes",
  "node_allocatable": "kube_node_status_allocatable{resource=~\"cpu|memory|ephemeral_storage|pods\"}",
  "all_pod_requests": "kube_pod_container_resource_requests{namespace=~\"aegis-step08|aegis-step08-monitoring|kube-system\"}",
  "api_placement": "kube_pod_info{namespace=\"aegis-step08\",pod=~\"aegis-step08-api-.*\"}",
  "k6_placement": "kube_pod_info{namespace=\"aegis-step08\",pod=~\"k6-.*\"}",
  "target_sample_age": "time() - timestamp(up)",
  "api_cpu_sample_age": "time() - timestamp(container_cpu_usage_seconds_total{namespace=\"aegis-step08\",container=\"api\"})",
  "k6_cpu_sample_age": "time() - timestamp(container_cpu_usage_seconds_total{namespace=\"aegis-step08\",container=\"k6\"})",
  "monitoring_cpu_sample_age": "time() - timestamp(container_cpu_usage_seconds_total{namespace=\"aegis-step08-monitoring\",container!=\"\",container!=\"POD\"})"
}
